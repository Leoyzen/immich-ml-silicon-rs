# immich-ml-rust environment configuration
# Copy to .envrc and fill in real values, then run: direnv allow

export DASHSCOPE_API_KEY=your-dashscope-api-key-here
export IMMICH_ML_DEVICE=coreml
export IMMICH_ML_DET_MODEL_PATH=$PWD/model-cache/det_10g_fixed.onnx
export IMMICH_ML_REC_MODEL_PATH=$PWD/model-cache/w600k_mbf23_fixed.onnx
export IMMICH_ML_OCR_BACKEND=vision
export IMMICH_ML_OCR_MIN_CONFIDENCE=0.1
export IMMICH_ML_FACE_DETECTION_BACKEND=onnx
export IMMICH_ML_CLIP_DIM=512
export IMMICH_ML_MAX_CONCURRENCY=20
export RUST_LOG=info
